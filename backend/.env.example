# Copy these into Render -> Environment (do NOT push real .env to GitHub)
PORT=8080
NODE_ENV=production
ORIGIN_ACCESS_URL=https://YOUR-SITE.netlify.app
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/homelyhub?appName=Cluster0
JWT_SECRET=put_a_long_random_text_here
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
IMAGEKIT_PUBLICKEY=public_xxxxx
IMAGEKIT_PRIVATEKEY=private_xxxxx
IMAGEKIT_URLENDPOINT=https://ik.imagekit.io/YOUR_ID
# Optional (only for forgot-password mail and AI features)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
GROQ_API_KEY=
